# ===========================================
# Enterprise AI Assistant - Environment Config
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub!

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_MAX_CONTEXT_CHARS=8000

# PostgreSQL Database (required)
DATABASE_URL=postgresql://postgres:your-password-here@localhost:5432/enterprise_assistant

# Docker Compose Postgres (optional — defaults to "postgres" if not set)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=enterprise_assistant

# Application Settings
APP_NAME=Enterprise AI Assistant
APP_VERSION=1.0.0
DEBUG=False

# Security — leave API_KEY empty to disable auth (dev mode)
API_KEY=your-secret-api-key-here
CORS_ORIGINS=http://localhost:8000,http://localhost:8001
